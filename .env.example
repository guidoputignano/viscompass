# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only — from Project Settings > API > service_role. Never prefix
# with NEXT_PUBLIC_ (that would ship it to the browser). Used only by
# trusted server-side code that intentionally bypasses RLS: admin
# feature-request responses, upload reconciliation writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails allowed into /admin routes, checked
# server-side against the live session's email.
ADMIN_EMAILS=admin@example.com
