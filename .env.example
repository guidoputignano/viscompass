# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Canonical public URL used in authentication/invitation emails. Vercel's
# automatic VERCEL_URL is used when this is omitted on a preview deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — from Project Settings > API > service_role. Never prefix
# with NEXT_PUBLIC_ (that would ship it to the browser). Used only by
# trusted server-side code that intentionally bypasses RLS: admin
# feature-request responses, upload reconciliation writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails allowed into /admin routes, checked
# server-side against the live session's email.
ADMIN_EMAILS=admin@example.com

# Dedicated VIS transactional email configuration. Verify the sender domain
# in the VIS Resend account before enabling these in Production.
RESEND_API_KEY=re_your_vis_account_key
VIS_EMAIL_FROM="VIS Pharma Compass <access@eurekene.com>"
VIS_EMAIL_REPLY_TO=access@eurekene.com

# Platform reviewers: accounts that may read EVERY Azienda in the private
# Pillar A release, by real name, regardless of their own membership.
#
# This is a deliberate exception to the anonymization rule in CLAUDE.md and is
# NOT the same capability as ADMIN_EMAILS. ADMIN_EMAILS grants the access
# Control Center (approving applications, sending invitations); this grants
# cross-Azienda visibility of clinical consumption data. Keep them separate.
#
# This variable is the ONLY source of the list. No address is compiled into the
# repository, which is public: a reviewer configured here is never published.
# Onboarding or removing a reviewer is an environment change - no deploy, no commit.
#
# FAILS CLOSED: left empty there are no reviewers at all and every account stays
# scoped to its own Azienda. The exception is inert until this is set.
#
# The unrestricted read uses the service-role client, so SUPABASE_SERVICE_ROLE_KEY
# must also be set wherever reviewers sign in. Without it a reviewer falls back
# to their own organization's scope and the page says so.
REVIEWER_EMAILS=
